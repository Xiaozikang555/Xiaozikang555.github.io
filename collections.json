---
layout: null
---
[
{%- assign entries = site.static_files | concat: site.pages -%}
{%- assign first = true -%}
{%- for file in entries -%}
  {%- assign filepath = file.path | prepend: '/' | replace: '//', '/' -%}
  {%- assign photo_prefix = filepath | slice: 0, 8 -%}
  {%- assign note_prefix = filepath | slice: 0, 7 -%}
  {%- if photo_prefix == '/photos/' or note_prefix == '/notes/' -%}
    {%- unless first -%},{%- endunless -%}
    {%- assign first = false -%}
    {"type":"file","path":{{ filepath | remove_first: '/' | jsonify }},"name":{{ filepath | split: '/' | last | jsonify }},"sha":{{ site.time | date: '%s' | jsonify }}}
  {%- endif -%}
{%- endfor -%}
]

